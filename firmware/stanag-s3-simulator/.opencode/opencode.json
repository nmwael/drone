{
  "$schema": "https://opencode.ai/config.json",
  "model": "nvidia/nvidia/nemotron-3-ultra-550b-a55b",
  "small_model": "nvidia/nemotron-3-8b-instruct",
  "provider": {
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM (integrate.api.nvidia.com)",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "headers": {
          "Authorization": "Bearer ${NVIDIA_API_KEY}"
        }
      },
      "models": {
        "nemotron-3-ultra-550b-a55b":            { "name": "Nemotron 3 Ultra 550B (NIM, strongest)", "limit": { "context": 131072, "output": 4096 } },
        "nemotron-3-nano-omni-30b-a3b-reasoning": { "name": "Nemotron 3 Nano Omni 30B (reasoning)",  "limit": { "context": 131072, "output": 4096 } },
        "nemotron-3.5-lightning-30b-a3b":         { "name": "Nemotron 3.5 Lightning 30B",           "limit": { "context": 131072, "output": 4096 } },
        "nemotron-3.5-super-vl-120b-a12b":       { "name": "Nemotron 3.5 Super VL 120B",           "limit": { "context": 131072, "output": 4096 } },
        "mistral-large-4-1t-a52b":                { "name": "Mistral Large 4 1T (NIM)",             "limit": { "context": 131072, "output": 4096 } }
      }
    },
    "mistral": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Mistral AI (api.mistral.ai)",
      "options": {
        "baseURL": "https://api.mistral.ai/v1",
        "headers": {
          "Authorization": "Bearer ${MISTRAL_API_KEY}"
        }
      },
      "models": {
        "mistral-small-latest": { "name": "Mistral Small 3 (fast, general)", "limit": { "context": 262144, "output": 8192 } },
        "mistral-medium-latest": { "name": "Mistral Medium 3.5 (strong reasoning)", "limit": { "context": 262144, "output": 8192 } },
        "codestral-2508": { "name": "Codestral 2508 (code-focused)", "limit": { "context": 256000, "output": 8192 } },
        "codestral-latest": { "name": "Codestral latest (alias of codestral-2508)", "limit": { "context": 256000, "output": 8192 } },
        "ministral-3b-2512": { "name": "Ministral 3B (small, fast)", "limit": { "context": 131072, "output": 8192 } },
        "ministral-8b-2512": { "name": "Ministral 8B (balanced)", "limit": { "context": 262144, "output": 8192 } },
        "ministral-14b-2512": { "name": "Ministral 14B (larger, capable)", "limit": { "context": 262144, "output": 8192 } }
      }
    },
    "opencode": {
      "options": {
        "setCacheKey": false
      }
    }
  },
  "agent": {
    "build":     { "model": "nvidia/nvidia/nemotron-3-ultra-550b-a55b", "temperature": 0.1, "steps": 50, "max_tokens": 16384 },
    "architect": { "model": "nvidia/nvidia/nemotron-3-ultra-550b-a55b", "temperature": 0.1, "steps": 30, "max_tokens": 16384 },
    "coder":     { "model": "nvidia/nemotron-3.5-lightning-30b-a3b",   "temperature": 0.1, "steps": 25, "max_tokens": 8192 },
    "researcher":{ "model": "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning", "temperature": 0.1, "steps": 20, "max_tokens": 8192 },
    "reviewer":  { "model": "mistralai/mistral-large-4-1t-a52b",       "temperature": 0.1, "steps": 15, "max_tokens": 8192 }
  },
  "enabled_providers": ["nvidia", "mistral", "opencode"],
  "plugins": ["./plugins/opencode-subagent-statusline"],
  "subagent_depth": 3,
  "permission": "allow",
  "limit": { "context": 131072 }
}
