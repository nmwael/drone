# Use the project's custom partition table (partitions.csv) which defines the
# 'spiffs' partition used to store JPEG frames for the STANAG simulator.
# Without this, ESP-IDF falls back to the built-in partitions_singleapp.csv
# which has no spiffs partition and the SPIFFS image generation fails.
CONFIG_PARTITION_TABLE_CUSTOM=y

# The STANAG simulator (jpeg_loader.c / main.c) calls esp_psram_get_size() and
# esp_psram_is_initialized(), which are only compiled when SPIRAM support is
# enabled. PSRAM is also required on the ESP32-S3 for the H.264 frame buffers.
CONFIG_SPIRAM=y
