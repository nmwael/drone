# Use the project's custom partition table (partitions.csv) which defines the
# 'spiffs' partition used to store JPEG frames for the STANAG simulator.
# Without this, ESP-IDF falls back to the built-in partitions_singleapp.csv
# which has no spiffs partition and the SPIFFS image generation fails.
CONFIG_PARTITION_TABLE_CUSTOM=y

# PSRAM configuration for ESP32-S3 with n16r8 (16MB Flash + 8MB PSRAM)
# AP Memory PSRAM (vendor 0x0d) - 8MB Octal/OPI mode
CONFIG_SPIRAM=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_SIZE=8388608
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
# Enable PSRAM allocation via heap_caps_malloc(MALLOC_CAP_SPIRAM)
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
# Also allow malloc to use PSRAM for larger allocations
CONFIG_SPIRAM_USE_MALLOC=y
# Don't use memory map only mode
CONFIG_SPIRAM_USE_MEMMAP=n

# WiFi Configuration for ESP-NOW + UDP
CONFIG_ESP32_WIFI_ENABLE_WPA3_SAE=y
CONFIG_ESP_WIFI_ESPNOW=y
CONFIG_ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM=6
CONFIG_ESP_WIFI_ESPNOW_ENABLE_LONG_RANGE=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=32

# WiFi STA credentials (set via menuconfig or environment)
# CONFIG_WIFI_SSID=""
# CONFIG_WIFI_PASSWORD=""

# Increase main task stack size to handle large frame processing
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288

# Status LED Configuration
CONFIG_STATUS_LED_GPIO=45
CONFIG_STATUS_LED_SCAN=n