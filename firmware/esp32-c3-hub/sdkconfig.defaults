# ESP32-C3 Sensor Hub - sdkconfig.defaults
# GPS + IMU + Mag + Baro + Temp/Humidity + EKF

# Target
CONFIG_IDF_TARGET="esp32c3"
CONFIG_IDF_TARGET_ESP32C3=y

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# Flash
CONFIG_FLASH_SIZE=4MB
CONFIG_FLASH_FREQ_80M=y

# CPU Frequency
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=160

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# WiFi - ESP-NOW for S3 comms, AP for ESP8266 relay
CONFIG_ESP32_WIFI_ENABLE_WPA3_SAE=y
CONFIG_ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM=6
CONFIG_ESP_WIFI_ESPNOW_ENABLE_LONG_RANGE=y

# UART - multiple for RP2040s + GPS
CONFIG_UART_ISR_IN_IRAM=y

# I2C - multiple sensors
CONFIG_I2C_ISR_IRAM_SAFE=y

# ESP-NOW
CONFIG_ESP_WIFI_ESPNOW=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y

# Optimization
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y