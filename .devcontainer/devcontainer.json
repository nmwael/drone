{
  "name": "Drone Firmware Development",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers-extra/features/apt-get-packages:1.0.8": {
      "packages": "curl,git,jq,build-essential,cmake,ninja-build,ffmpeg,clangd,clang-tools,python3-pip,python3-venv,vim,tmux,htop,net-tools,iproute2,iputils-ping,unzip,wget,ca-certificates,libusb-1.0-0,minicom,screen,usbutils,picocom"
    },
    "ghcr.io/devcontainers-extra/features/npm-package:1.0.4": {
      "package": "@opencode/cli",
      "version": "2"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts",
      "installTools": true
    },
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.22"
    },
    "ghcr.io/devcontainers/features/common-utils:1": {},
    "ghcr.io/nmwael/agentic-devcontainer-feature/models:1": {
      "modelsConfig": ".devcontainer/llm-lab-models.json",
      "rolesConfig": ".devcontainer/llm-lab-roles.json",
      "profilesDir": "profiles",
      "defaultProfile": "cloud",
      "cacheDir": "/workspace/.cache/llm-lab",
      "modelsDir": "/workspace/models"
    },
    "ghcr.io/nmwael/agentic-devcontainer-feature/opencode-agents:1": {
      "INSTALL_DIR": "/workspace/.opencode",
      "WITH_LIBRARY": "true",
      "OVERWRITE": "true"
    },
    "ghcr.io/nmwael/agentic-devcontainer-feature/bifrost-gateway:1": {
      "configStoreEnabled": "true",
      "configStoreType": "sqlite",
      "configStorePath": "/workspace/.config/bifrost/config.db",
      "port": 8082
    }
  },
  "postCreateCommand": "bash /workspaces/drone/.devcontainer/setup-esp-idf.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "espressif.esp-idf-extension",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "llvm-vs-code-extensions.vscode-clangd"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "args": [
              "--init-file",
              "/workspaces/drone/.devcontainer/esp-idf-env.sh"
            ]
          }
        },
        "clangd.path": "/home/vscode/.local/bin/clangd",
        "clangd.arguments": [
          "--compile-commands-dir=/workspaces/drone/firmware/stanag-s3-simulator/build",
          "--header-insertion=never",
          "--background-index",
          "--suggest-missing-includes",
          "--all-scopes-completion",
          "--clang-tidy",
          "--header-insertion=iwyu",
          "--function-arg-placeholders",
          "--fallback-style=LLVM",
          "--limit-results=20",
          "--pch-storage=memory"
        ],
        "C_Cpp.intelliSenseEngine": "disabled",
        "C_Cpp.errorSquiggles": "disabled",
        "files.associations": {
          "*.c": "c",
          "*.h": "c"
        }
      }
    }
  },
  "runArgs": [
    "--privileged",
    "--device=/dev/ttyACM0"
  ],
  "remoteEnv": {
    "NVIDIA_API_KEY": "${localEnv:NVIDIA_API_KEY}"
  },
  "postStartCommand": "bash -c \"modprobe cdc_acm 2>/dev/null || true; udevadm trigger --subsystem-match=tty 2>/dev/null || true; chmod 666 /dev/ttyACM* 2>/dev/null || true; chmod 666 /dev/ttyUSB* 2>/dev/null || true\"; nohup bash .devcontainer/scripts/auto-startup.sh > /home/vscode/.cache/auto-startup.log 2>&1 & bash -c \"if [ -d /home/vscode/.local ]; then chown -R vscode:vscode /home/vscode/.local; echo Fixed /home/vscode/.local ownership; fi\"; bash .devcontainer/scripts/agent-status.sh update 'opencode-server' 'server' 'running' 'OpenCode API server on port 4096' 0",
  "remoteUser": "vscode"
}