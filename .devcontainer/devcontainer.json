{
  "name": "drone-sensor-suite",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers-extra/features/apt-get-packages:1.0.8": {
      "packages": "curl,git,jq,build-essential,cmake,ninja-build,ffmpeg,python3-pip,python3-venv,vim,tmux,htop,net-tools,iproute2,iputils-ping,unzip,wget,ca-certificates"
    },
    "ghcr.io/devcontainers-extra/features/npm-package:1.0.4": {
      "package": "@opencode/cli",
      "version": "2.1.2"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts",
      "installTools": true
    },
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.22"
    },
    "ghcr.io/devcontainers/features/common-utils:1": {},
    "ghcr.io/nmwael/agentic-devcontainer-feature/models:1": {
      "modelsConfig": ".devcontainer/llm-lab-models.json",
      "rolesConfig": ".devcontainer/llm-lab-roles.json",
      "profilesDir": "profiles",
      "defaultProfile": "cloud",
      "cacheDir": "/workspace/.cache/llm-lab",
      "modelsDir": "/workspace/models"
    },
    "ghcr.io/nmwael/agentic-devcontainer-feature/opencode-agents:1": {
      "INSTALL_DIR": "/workspace/.opencode",
      "WITH_LIBRARY": "true",
      "OVERWRITE": "true"
    },
    "ghcr.io/nmwael/agentic-devcontainer-feature/bifrost-gateway:1": {
      "configStoreEnabled": "true",
      "configStoreType": "sqlite",
      "configStorePath": "/workspace/.config/bifrost/config.db",
      "port": 8082
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode-remote.remote-containers",
        "ms-python.python",
        "ms-vscode.cpptools",
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cmake-tools",
        "timonwong.shellcheck",
        "foxundermoon.shell-format",
        "redhat.vscode-yaml",
        "ms-vscode.makefile-tools"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.autoSave": "onFocusChange",
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      }
    }
  },
  "forwardPorts": [
    8082,
    4096
  ],
  "postCreateCommand": "bash .devcontainer/scripts/post-create.sh",
  "postStartCommand": "bash .devcontainer/scripts/auto-startup.sh",
  "postAttachCommand": "echo 'Container ready. Run: bash scripts/use-profile.sh cloud'",
  "mounts": [
    "source=${localWorkspaceFolder}/models,target=/workspace/models,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/.cache,target=/workspace/.cache,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/.config,target=/workspace/.config,type=bind,consistency=cached"
  ],
  "remoteEnv": {
    "CLOUD_MODE": "${localEnv:CLOUD_MODE:-true}",
    "NVIDIA_API_KEY": "${localEnv:NVIDIA_API_KEY}",
    "NVIDIA_NIM_ENDPOINT": "https://integrate.api.nvidia.com/v1",
    "OPENCODE_CONFIG": "/workspace/.devcontainer/opencode.json",
    "LLM_LAB_MODELS_DIR": "/workspace/models",
    "LLM_LAB_CACHE_DIR": "/workspace/.cache/llm-lab",
    "BIFROST_CONFIG": "/workspace/.config/bifrost/config.json",
    "BIFROST_CONFIG_STORE_PATH": "/workspace/.config/bifrost/config.db"
  },
  
  "containerEnv": {
    "DEBIAN_FRONTEND": "noninteractive",
    "TZ": "Europe/Copenhagen"
  }
}