# clangd configuration for ESP-IDF STANAG S3 Simulator
# Target: ESP32-S3, ESP-IDF v5.5.6

CompileFlags:
  # Use the compile_commands.json generated by CMake
  Database: build/compile_commands.json
  # Add ESP-IDF include paths for better indexing
  Add:
    - -I/home/vscode/.espressif/v5.5.6/esp-idf/components/esp_hw_support/include
    - -I/home/vscode/.espressif/v5.5.6/esp-idf/components/esp_hw_support/include/soc
    - -I/home/vscode/.espressif/v5.5.6/esp-idf/components/esp_hw_support/include/soc/esp32s3
    - -I/home/vscode/.espressif/v5.5.6/esp-idf/components/esp_system/include
    - -I/home/vscode/.espressif/v5.5.6/esp-idf/components/esp_wifi/include
    - -I/home/vscode/.espressif/v5.5.6/esp-idf/components/esp_netif/include
    - -I/home/vscode/.espressif/v5.5.6/esp-idf/components/esp_event/include
    - -I/home/vscode/.espressif/v5.5.6/esp-idf/components/nvs_flash/include
    - -I/home/vscode/.espressif/v5.5.6/esp-idf/components/esp_timer/include
    - -I/home/vscode/.espressif/v5.5.6/esp-idf/components/driver/include
    - -I/home/vscode/.espressif/v5.5.6/esp-idf/components/esp_driver_rmt/include
    - -I/home/vscode/.espressif/v5.5.6/esp-idf/components/log/include
    - -I/home/vscode/.espressif/v5.5.6/esp-idf/components/spiffs/include
    - -I/home/vscode/.espressif/v5.5.6/esp-idf/components/freertos/FreeRTOS-Kernel/include
    - -I/home/vscode/.espressif/v5.5.6/esp-idf/components/freertos/FreeRTOS-Kernel/portable/xtensa/include
    - -I/home/vscode/.espressif/v5.5.6/esp-idf/components/freertos/FreeRTOS-Kernel/portable/xtensa/include/freertos
    - -I/home/vscode/.espressif/v5.5.6/esp-idf/components/mbedtls/port/include
    - -I/home/vscode/.espressif/v5.5.6/esp-idf/components/mbedtls/mbedtls/include
    - -I/home/vscode/.espressif/v5.5.6/esp-idf/components/esp_psram/include
    - -I/home/vscode/.espressif/v5.5.6/esp-idf/components/heap/include
    - -I/home/vscode/.espressif/v5.5.6/esp-idf/components/soc/esp32s3/include
    - -I/home/vscode/.espressif/v5.5.6/esp-idf/components/hal/esp32s3/include
    - -I/home/vscode/.espressif/v5.5.6/esp-idf/components/hal/include
    - -I/home/vscode/.espressif/v5.5.6/esp-idf/components/xtensa/esp32s3/include
    - -I/home/vscode/.espressif/v5.5.6/esp-idf/components/xtensa/include
    - -I/home/vscode/.espressif/v5.5.6/esp-idf/components/newlib/include
    - -I/home/vscode/.espressif/v5.5.6/esp-idf/components/newlib/platform_include
    - -I/workspaces/drone/firmware/stanag-s3-simulator/main
    - -I/workspaces/drone/firmware/stanag-s3-simulator/components/srt/include
    - -DMBEDTLS_CONFIG_FILE="\"mbedtls/esp_config.h\""
    - -DSOC_MMU_PAGE_SIZE=CONFIG_MMU_PAGE_SIZE
    - -DSOC_XTAL_FREQ_MHZ=CONFIG_XTAL_FREQ
    - -DUNITY_INCLUDE_CONFIG_H
    - -DHAVE_CONFIG_H
    - -D__XTENSA__
    - -D__ESP32S3__
    - -std=c99
    - -Wall
    - -Wno-unused-parameter
    - -Wno-sign-compare
  Remove: []

# Index settings
Index:
  Library:
    # Enable cross-reference indexing
    Enable: true
  Background:
    Build: true
    UpdateOnChange: true
    UpdateOnSave: true

# Diagnostics
Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: Strict

# Formatting
Format:
  BasedOnStyle: LLVM
  ColumnLimit: 120

# File watcher
Watcher: none

# Use ESP-IDF cross compiler when available
# clangd will try to use the compiler from compile_commands.json
# If xtensa-esp32s3-elf-gcc is not found by clangd, it falls back to host clang
